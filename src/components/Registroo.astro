---
import videoBlueSrcFromComponent from "@assets/videos/file3.mp4";
// const videoRedSrcFromComponent =
//     "https://videos.pexels.com/video-files/2715412/2715412-uhd_2560_1440_30fps.mp4";
import videoRedSrcFromComponent from "@assets/videos/file4.mp4";
import pagoQrImage from "@assets/imgs/pago-qr.svg";
import ButtonDefault from "./buttons/ButtonDefault.astro";
import ButtonDanger from "./buttons/ButtonDanger.astro";
import RefDanger from "./buttons/RefDanger.astro";
import Title from "./Title.astro";
import DigitCodeInput from "./DigitCodeInput.astro";
import { CODIGOS_DEMO, NOMBRE_EQUIPO_DEMO } from "@/data/estudiante-demo";

// Prefilled with a fictional demo team so the flow can be tried without typing.
const integrantes = [1, 2, 3, 4, 5].map((numero) => ({
    numero,
    rol: numero === 1 ? "Capitán" : `Integrante ${numero}`,
    codigoDemo: CODIGOS_DEMO[numero - 1],
}));
---

<div
    class="registro-root h-dvh bg-black text-white flex flex-col items-center justify-center relative overflow-hidden font-aminute"
    data-theme="red"
    transition:animate="fade"
>
    <script is:inline>
        // Apply the theme chosen on the home page ("Cambiar tema") before the form paints.
        try {
            if (localStorage.getItem("activeVideoTheme") === "video-blue") {
                document.currentScript.parentElement.dataset.theme = "blue";
            }
        } catch (e) {}
    </script>

    <!-- Videos de fondo -->
    <video
        id="registro-video-red"
        src={videoRedSrcFromComponent}
        class="hidden absolute top-0 left-0 w-full h-full object-cover z-0 opacity-75 animate-fade-in"
        autoplay
        muted
        loop
        playsinline></video>
    <video
        id="registro-video-blue"
        src={videoBlueSrcFromComponent}
        class="hidden absolute top-0 left-0 w-full h-full object-cover z-0 opacity-75 animate-fade-in"
        autoplay
        muted
        loop
        playsinline></video>

    <!-- Contenido del formulario de registro -->
    <div
        class="relative z-10 flex flex-col items-center text-center p-4 w-full max-w-2xl max-h-[90vh]"
    >
        <div class="flex-col sm:flex-row flex justify-center items-center sm:justify-between gap-2 mb-6 w-full">
          <RefDanger idbtn="back" to="/" className="!rounded-sm !px-4 !py-2 !text-center font-aminute animate-blurred-fade-in" label="Volver" />
          <Title
            className="!text-3xl sm:!text-4xl !animate-blurred-fade-in"
            label="registro de equipo"
          />
          <div class="hidden sm:block"></div>
        </div>

        <!-- Indicador de pasos -->
        <ol
            class="flex items-center w-full max-w-sm mb-6 text-xs sm:text-sm uppercase tracking-widest"
            aria-label="Pasos del registro"
        >
            <li class="step-indicator flex items-center gap-2" data-step-indicator="1">
                <span class="step-dot">1</span>
                <span>Equipo</span>
            </li>
            <li class="flex-1 h-px mx-3 bg-white/25" aria-hidden="true"></li>
            <li class="step-indicator flex items-center gap-2" data-step-indicator="2">
                <span class="step-dot">2</span>
                <span>Pago</span>
            </li>
        </ol>

        <form
            id="formRegistroEquipo"
            novalidate
            class="w-full max-w-2xl bg-black/50 p-6 md:p-8 rounded-lg shadow-xl flex flex-col max-h-[calc(80vh-55px)] backdrop-blur-md animate-zoom-in"
        >
            <!-- Paso 1: datos del equipo -->
            <section data-step="1" class="flex flex-col min-h-0 flex-1">
                <div
                    class="flex-grow min-h-0 overflow-y-auto pr-2 space-y-6 custom-scrollbar-container"
                >
                    <div>
                        <label
                            for="nombreEquipo"
                            class="block text-left text-lg mb-2"
                        >
                            Nombre del Equipo:
                        </label>
                        <input
                            type="text"
                            id="nombreEquipo"
                            name="nombreEquipo"
                            value={NOMBRE_EQUIPO_DEMO}
                            autocomplete="off"
                            class="w-full p-3 rounded bg-white/20 text-white placeholder-gray-300 focus:ring-2 focus:ring-red-500 outline-none tracking-widest"
                        />
                        <p id="errorNombreEquipo" class="field-error" role="alert"></p>
                    </div>

                    <h2 class="text-2xl mt-6 mb-2">Integrantes del Equipo</h2>
                    <p class="mb-4 text-sm">
                        Escribe el código de estudiante de cada integrante y
                        presiona Verificar. Los datos se cargarán
                        automáticamente.
                    </p>

                    {
                        integrantes.map(({ numero, rol, codigoDemo }) => (
                            <div
                                class="integrante-card p-4 border border-white/20 rounded-md transition-colors"
                                data-integrante={numero}
                            >
                                <label
                                    for={`codigoIntegrante${numero}`}
                                    class="block text-left text-lg mb-2"
                                >
                                    Código Estudiante ({rol}):
                                </label>
                                <div class="flex items-center gap-2">
                                    <input
                                        type="text"
                                        id={`codigoIntegrante${numero}`}
                                        name={`codigoIntegrante${numero}`}
                                        value={codigoDemo}
                                        inputmode="numeric"
                                        autocomplete="off"
                                        maxlength="10"
                                        placeholder="Ej: 2018000000"
                                        class="integrante-codigo w-full p-2 rounded bg-white/20 text-white placeholder-gray-300 focus:ring-2 focus:ring-red-500 outline-none tracking-widest"
                                        data-integrante-index={numero}
                                    />
                                    <button
                                        type="button"
                                        class="verificar-codigo-btn verificar-button-dota-style flex-shrink-0"
                                        data-integrante-index={numero}
                                    >
                                        Verificar
                                    </button>
                                </div>
                                <p
                                    id={`errorIntegrante${numero}`}
                                    class="field-error"
                                    role="alert"
                                />
                                <div
                                    id={`datosIntegrante${numero}`}
                                    class="text-left mt-2 text-sm text-gray-300"
                                    aria-live="polite"
                                />
                                <input
                                    type="hidden"
                                    name={`nombreIntegrante${numero}`}
                                    id={`nombreIntegrante${numero}`}
                                />
                                <input
                                    type="hidden"
                                    name={`programaIntegrante${numero}`}
                                    id={`programaIntegrante${numero}`}
                                />
                            </div>
                        ))
                    }
                </div>

                <div class="mt-auto pt-6">
                    <ButtonDanger type="submit" label="Continuar al pago" />
                </div>
            </section>

            <!-- Paso 2: pago -->
            <section data-step="2" hidden class="flex flex-col min-h-0 flex-1">
                <div
                    class="flex-grow min-h-0 overflow-y-auto pr-2 space-y-4 custom-scrollbar-container"
                >
                    <div class="text-left bg-white/5 border border-white/15 rounded-md p-4">
                        <p class="text-xs uppercase tracking-widest text-gray-400">
                            Equipo
                        </p>
                        <p id="resumenNombreEquipo" class="text-xl mb-2 break-words"></p>
                        <ul id="resumenIntegrantes" class="text-sm text-gray-300 space-y-1"></ul>
                    </div>

                    <p>
                        Para completar la inscripción paga <strong
                            class="text-purple-400">S/50.00</strong
                        > escaneando este QR:
                    </p>
                    <img
                        src={pagoQrImage.src}
                        width="220"
                        height="250"
                        alt="QR de pago a nombre de Kevin Arnold Flores Pacheco"
                        class="mx-auto w-52 sm:w-56 h-auto rounded-2xl"
                    />
                    <p>
                        Luego ingresa el <strong class="accent-text"
                            >código de aprobación</strong
                        > de Yape (6 dígitos):
                    </p>
                    <DigitCodeInput
                        id="codigoAprobacionYape"
                        name="codigoOperacionYape"
                        label="Código de aprobación"
                    />
                    <p id="errorPago" class="field-error !text-center" role="alert"></p>
                </div>

                <div class="mt-auto pt-6 flex flex-col-reverse sm:flex-row gap-3">
                    <ButtonDefault type="button" idbtn="volverPasoEquipoBtn" label="Atrás" />
                    <ButtonDanger type="submit" idbtn="confirmarPagoBtn" label="Confirmar pago" />
                </div>
            </section>

            <!-- Registro enviado -->
            <section
                data-step="3"
                hidden
                class="flex flex-col items-center justify-center gap-4 py-6 flex-1"
            >
                <div
                    class="size-16 rounded-full bg-green-500/20 border border-green-400/50 flex items-center justify-center text-3xl text-green-400"
                    aria-hidden="true"
                >
                    ✓
                </div>
                <h2 class="text-2xl">¡Inscripción enviada!</h2>
                <p id="mensajeExito" class="text-gray-300 max-w-md"></p>
                <div class="w-full max-w-xs pt-2">
                    <ButtonDanger type="button" idbtn="registrarOtroBtn" label="Registrar otro equipo" />
                </div>
            </section>
        </form>
        <div
            id="mensajeRespuestaRegistro"
            class="mt-4 text-sm md:text-base font-semibold"
            role="status"
            aria-live="polite"
        >
        </div>
    </div>
</div>

<style>
    /* Asegúrate de que la clase hidden funcione para ocultar */
    .hidden {
        display: none;
    }

    .custom-scrollbar-container::-webkit-scrollbar {
        width: 8px;
    }
    .custom-scrollbar-container::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
    }
    .custom-scrollbar-container::-webkit-scrollbar-thumb {
        background: rgba(220, 38, 38, 0.7);
        border-radius: 10px;
    }
    .custom-scrollbar-container::-webkit-scrollbar-thumb:hover {
        background: rgba(185, 28, 28, 0.9);
    }
    .custom-scrollbar-container {
        scrollbar-width: thin;
        scrollbar-color: rgba(220, 38, 38, 0.7) rgba(255, 255, 255, 0.1);
    }

    .verificar-button-dota-style {
        background: linear-gradient(to bottom, #6b211c, #8e2b19);
        border: 1px solid #bc4539;
        color: white;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        padding: 9px 12px;
        cursor: url('/cursors/pointer.png'), pointer;
        transition:
            filter 0.1s linear,
            border 0.1s linear;
        text-shadow: 0px 0px 6px rgba(0, 0, 0, 1);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
    }

    @media (min-width: 640px) {
        .verificar-button-dota-style {
            padding: 12px 24px; /* Padding original para pantallas grandes */
        }
    }

    .verificar-button-dota-style:hover {
        filter: brightness(1.2);
    }
    .verificar-button-dota-style:active {
        filter: brightness(1.4);
        border-color: #501f18;
        transform: translateY(1px);
    }

    .field-error {
        margin-top: 0.5rem;
        color: #f87171;
        font-size: 0.875rem;
        text-align: left;
    }
    .field-error:empty {
        display: none;
    }

    .integrante-card[data-verified] {
        border-color: rgba(74, 222, 128, 0.45);
    }
    .integrante-card[data-invalid] {
        border-color: rgba(248, 113, 113, 0.75);
    }

    /* Step pills, styled like the Dota buttons. */
    .step-indicator {
        padding: 0.3rem 0.9rem 0.3rem 0.35rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 5px;
        background: rgba(0, 0, 0, 0.35);
        color: rgba(255, 255, 255, 0.5);
        transition: all 0.25s ease-in-out;
    }
    .step-dot {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.6rem;
        height: 1.6rem;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.35);
        font-size: 0.8rem;
    }
    .step-indicator[data-state="active"] {
        color: white;
        background: linear-gradient(to bottom, #6b211c, #8e2b19);
        border-color: #bc4539;
        text-shadow: 0px 0px 6px rgba(0, 0, 0, 1);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
    }
    .step-indicator[data-state="active"] .step-dot {
        border-color: rgba(255, 255, 255, 0.6);
    }
    /* Completed step: same look as the home "Registra a tu equipo" button. */
    .step-indicator[data-state="done"] {
        color: white;
        background: linear-gradient(to bottom, #3d7c3c, #2d5c2a);
        background-image: url("/textures/dota_pattern.png");
        background-size: cover;
        background-blend-mode: overlay;
        border-color: #4caf50;
        text-shadow:
            0 1px 2px rgba(0, 0, 0, 0.8),
            0 0 8px #a4ffb1;
        box-shadow:
            0 0 16px 3px rgba(102, 255, 153, 0.45),
            inset 0 0 12px rgba(0, 0, 0, 0.7);
    }
    .step-indicator[data-state="done"] .step-dot {
        border-color: #a4ffb1;
        box-shadow: 0 0 6px rgba(164, 255, 177, 0.7);
    }

    .accent-text {
        color: #f87171;
    }

    :global(#confirmarPagoBtn:disabled) {
        opacity: 0.6;
        cursor: progress;
    }
</style>

<style is:global>
    /* Blue (clouds) theme: steel-blue accents instead of the fire-red ones. */
    .registro-root[data-theme="blue"] :is(.dota-button-danger, .verificar-button-dota-style) {
        background: linear-gradient(to bottom, #1f3a5a, #2e5580);
        border-color: #4f7cac;
    }
    .registro-root[data-theme="blue"] :is(.dota-button-danger, .verificar-button-dota-style):active {
        border-color: #14263b;
    }
    .registro-root[data-theme="blue"] .step-indicator[data-step-indicator][data-state="active"] {
        background: linear-gradient(to bottom, #1f3a5a, #2e5580);
        border-color: #4f7cac;
    }
    .registro-root[data-theme="blue"] .accent-text {
        color: #7fb0e0;
    }
    .registro-root[data-theme="blue"] input:focus {
        --tw-ring-color: rgb(91 143 199 / 0.7);
        border-color: #5b8fc7;
    }
    .registro-root[data-theme="blue"] .digit-code-box {
        caret-color: #5b8fc7;
    }
    .registro-root[data-theme="blue"] .custom-scrollbar-container {
        scrollbar-color: rgba(91, 143, 199, 0.7) rgba(255, 255, 255, 0.1);
    }
    .registro-root[data-theme="blue"] .custom-scrollbar-container::-webkit-scrollbar-thumb {
        background: rgba(91, 143, 199, 0.7);
    }
</style>

<script>
    import { getEstudianteDemo } from "@/data/estudiante-demo";

    const CODIGO_ESTUDIANTE = /^\d{10}$/;
    const CODIGO_APROBACION = /^\d{6}$/;
    const NUMEROS_INTEGRANTES = [1, 2, 3, 4, 5];
    // Short pause so the "verifying" / "processing" states are visible in the demo.
    const DEMORA_SIMULADA_MS = 400;

    const esperar = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    function setupBackgroundVideo() {
        const videoRed = document.querySelector("#registro-video-red");
        const videoBlue = document.querySelector("#registro-video-blue");

        // Preferencia guardada por Welcome.astro
        let preferredVideoId = "video-red";
        try {
            preferredVideoId = localStorage.getItem("activeVideoTheme") || preferredVideoId;
        } catch (e) {
            console.error("Error reading from localStorage:", e);
        }

        const [visible, oculto] =
            preferredVideoId === "video-blue" ? [videoBlue, videoRed] : [videoRed, videoBlue];
        if (visible instanceof HTMLVideoElement) {
            visible.classList.remove("hidden");
            visible.play().catch((e) => console.warn("Video play interrupted", e));
        }
        if (oculto instanceof HTMLVideoElement) {
            oculto.classList.add("hidden");
            oculto.pause();
        }
    }

    function initializeRegistro() {
        const form = document.getElementById("formRegistroEquipo");
        if (!(form instanceof HTMLFormElement) || form.dataset.ready) return;
        form.dataset.ready = "true";

        setupBackgroundVideo();

        const byId = <T extends HTMLElement = HTMLElement>(id: string) =>
            document.getElementById(id) as T | null;

        const mensaje = byId("mensajeRespuestaRegistro");
        const nombreEquipoInput = byId<HTMLInputElement>("nombreEquipo");
        const errorNombreEquipo = byId("errorNombreEquipo");
        const codigoAprobacionInput = byId<HTMLInputElement>("codigoAprobacionYape");
        const errorPago = byId("errorPago");
        const confirmarPagoBtn = byId<HTMLButtonElement>("confirmarPagoBtn");
        const pasos = form.querySelectorAll<HTMLElement>("[data-step]");
        const indicadores = document.querySelectorAll<HTMLElement>("[data-step-indicator]");

        let pasoActual = 1;
        let enviando = false;

        function mostrarMensaje(texto: string, tipo: "info" | "error" = "info") {
            if (!mensaje) return;
            mensaje.textContent = texto;
            mensaje.className = `mt-4 text-sm md:text-base font-semibold ${
                tipo === "error" ? "text-red-400" : "text-yellow-400"
            }`;
        }

        function integrante(n: number) {
            return {
                card: form!.querySelector<HTMLElement>(`[data-integrante="${n}"]`),
                codigo: byId<HTMLInputElement>(`codigoIntegrante${n}`),
                nombre: byId<HTMLInputElement>(`nombreIntegrante${n}`),
                programa: byId<HTMLInputElement>(`programaIntegrante${n}`),
                datos: byId(`datosIntegrante${n}`),
                error: byId(`errorIntegrante${n}`),
            };
        }

        function linea(texto: string, clase = "") {
            const p = document.createElement("p");
            p.className = clase;
            p.textContent = texto;
            return p;
        }

        function campo(etiqueta: string, valor: string) {
            const p = document.createElement("p");
            const strong = document.createElement("strong");
            strong.textContent = `${etiqueta}: `;
            p.append(strong, valor);
            return p;
        }

        // Hidden inputs are not cleared by form.reset(), so verification data is cleared explicitly.
        function limpiarVerificacion(n: number) {
            const { card, nombre, programa, datos } = integrante(n);
            if (nombre) nombre.value = "";
            if (programa) programa.value = "";
            datos?.replaceChildren();
            card?.removeAttribute("data-verified");
        }

        function setErrorIntegrante(n: number, texto: string) {
            const { card, error } = integrante(n);
            if (error) error.textContent = texto;
            card?.toggleAttribute("data-invalid", Boolean(texto));
        }

        function estaVerificado(n: number) {
            const { nombre, programa } = integrante(n);
            return Boolean(nombre?.value && programa?.value);
        }

        async function verificarIntegrante(n: number) {
            const { card, codigo, nombre, programa, datos } = integrante(n);
            if (!codigo || !nombre || !programa) return;

            const valor = codigo.value.trim();
            limpiarVerificacion(n);
            if (!CODIGO_ESTUDIANTE.test(valor)) {
                setErrorIntegrante(n, "El código debe tener 10 dígitos numéricos.");
                codigo.focus();
                return;
            }
            setErrorIntegrante(n, "");
            datos?.replaceChildren(linea("Verificando código...", "text-yellow-400"));

            // Static demo: students resolve locally from fictional data; no external service is called.
            await esperar(DEMORA_SIMULADA_MS);
            if (codigo.value.trim() !== valor) return; // the code changed while verifying
            const estudiante = getEstudianteDemo(valor);

            const nombreCompleto = [
                estudiante.stu_nombres,
                estudiante.stu_apellido_paterno,
                estudiante.stu_apellido_materno,
            ]
                .filter(Boolean)
                .join(" ")
                .trim();
            nombre.value = nombreCompleto;
            programa.value = estudiante.stu_programa;
            card?.setAttribute("data-verified", valor);
            datos?.replaceChildren(
                campo("Nombre", nombreCompleto),
                campo("Programa", estudiante.stu_programa),
                linea("✓ Datos cargados.", "text-green-400"),
            );
        }

        // Returns the first invalid field, or null when the team step is complete.
        function validarPasoEquipo(): HTMLElement | null {
            let primerInvalido: HTMLElement | null = null;
            const marcar = (elemento: HTMLElement | null) => {
                if (!primerInvalido) primerInvalido = elemento;
            };

            const nombreEquipo = nombreEquipoInput?.value.trim() ?? "";
            if (errorNombreEquipo) {
                errorNombreEquipo.textContent = nombreEquipo ? "" : "Ingresa el nombre del equipo.";
            }
            if (!nombreEquipo) marcar(nombreEquipoInput);

            const codigos = NUMEROS_INTEGRANTES.map((n) => integrante(n).codigo?.value.trim() ?? "");
            NUMEROS_INTEGRANTES.forEach((n, index) => {
                const codigo = codigos[index];
                let error = "";
                if (!CODIGO_ESTUDIANTE.test(codigo)) {
                    error = "El código debe tener 10 dígitos numéricos.";
                } else if (codigos.indexOf(codigo) !== index) {
                    error = "Este código ya está en otro integrante.";
                } else if (!estaVerificado(n)) {
                    error = "Verifica este código antes de continuar.";
                }
                setErrorIntegrante(n, error);
                if (error) marcar(integrante(n).codigo);
            });

            return primerInvalido;
        }

        function irAPaso(paso: number) {
            pasoActual = paso;
            pasos.forEach((seccion) => {
                seccion.hidden = Number(seccion.dataset.step) !== paso;
            });
            indicadores.forEach((indicador) => {
                const n = Number(indicador.dataset.stepIndicator);
                const estado = n < paso ? "done" : n === paso ? "active" : "pending";
                indicador.dataset.state = estado;
                indicador.toggleAttribute("aria-current", estado === "active");
                const dot = indicador.querySelector(".step-dot");
                if (dot) dot.textContent = estado === "done" ? "✓" : String(n);
            });
        }

        function renderResumen() {
            const nombreEl = byId("resumenNombreEquipo");
            if (nombreEl) nombreEl.textContent = nombreEquipoInput?.value.trim() ?? "";
            byId("resumenIntegrantes")?.replaceChildren(
                ...NUMEROS_INTEGRANTES.map((n) =>
                    linea(`${n === 1 ? "Capitán" : `Integrante ${n}`}: ${integrante(n).nombre?.value ?? ""}`),
                ),
            );
        }

        function continuarAlPago() {
            const invalido = validarPasoEquipo();
            if (invalido) {
                mostrarMensaje("Revisa los campos marcados antes de continuar.", "error");
                invalido.focus();
                invalido.scrollIntoView({ block: "center", behavior: "smooth" });
                return;
            }
            mostrarMensaje("");
            renderResumen();
            if (errorPago) errorPago.textContent = "";
            irAPaso(2);
            form!.querySelector<HTMLInputElement>(".digit-code-box")?.focus();
        }

        async function confirmarPago() {
            if (enviando) return;

            const codigoAprobacion = codigoAprobacionInput?.value ?? "";
            if (!CODIGO_APROBACION.test(codigoAprobacion)) {
                if (errorPago) errorPago.textContent = "Ingresa los 6 dígitos del código de aprobación.";
                Array.from(form!.querySelectorAll<HTMLInputElement>(".digit-code-box"))
                    .find((box) => !box.value)
                    ?.focus();
                return;
            }
            if (errorPago) errorPago.textContent = "";

            enviando = true;
            if (confirmarPagoBtn) confirmarPagoBtn.disabled = true;
            mostrarMensaje("Procesando registro...");

            try {
                // Static demo: nothing is sent or stored, the registration is simulated.
                await esperar(DEMORA_SIMULADA_MS);
                const exito = byId("mensajeExito");
                if (exito) exito.textContent = "Equipo registrado exitosamente (modo demo: los datos no se guardan).";
                mostrarMensaje("");
                irAPaso(3);
            } finally {
                enviando = false;
                if (confirmarPagoBtn) confirmarPagoBtn.disabled = false;
            }
        }

        function reiniciarFormulario() {
            form!.reset();
            NUMEROS_INTEGRANTES.forEach((n) => {
                limpiarVerificacion(n);
                setErrorIntegrante(n, "");
            });
            if (errorNombreEquipo) errorNombreEquipo.textContent = "";
            if (errorPago) errorPago.textContent = "";
            mostrarMensaje("");
            irAPaso(1);
            nombreEquipoInput?.focus();
        }

        // Eventos
        NUMEROS_INTEGRANTES.forEach((n) => {
            const { card, codigo } = integrante(n);
            codigo?.addEventListener("input", () => {
                const soloDigitos = codigo.value.replace(/\D/g, "").slice(0, 10);
                if (soloDigitos !== codigo.value) codigo.value = soloDigitos;
                // Verified data belongs to the code it was fetched for.
                if (card?.getAttribute("data-verified") !== soloDigitos) limpiarVerificacion(n);
                setErrorIntegrante(n, "");
            });
            codigo?.addEventListener("keydown", (event) => {
                if (event.key === "Enter") {
                    event.preventDefault();
                    verificarIntegrante(n);
                }
            });
        });

        form.querySelectorAll<HTMLButtonElement>(".verificar-codigo-btn").forEach((button) => {
            button.addEventListener("click", () => verificarIntegrante(Number(button.dataset.integranteIndex)));
        });

        nombreEquipoInput?.addEventListener("input", () => {
            if (errorNombreEquipo && nombreEquipoInput.value.trim()) errorNombreEquipo.textContent = "";
        });

        form.addEventListener("digit-code:change", () => {
            if (errorPago) errorPago.textContent = "";
        });

        form.addEventListener("submit", (event) => {
            event.preventDefault();
            if (pasoActual === 1) continuarAlPago();
            else if (pasoActual === 2) confirmarPago();
        });

        byId("volverPasoEquipoBtn")?.addEventListener("click", () => {
            mostrarMensaje("");
            irAPaso(1);
        });
        byId("registrarOtroBtn")?.addEventListener("click", reiniciarFormulario);

        irAPaso(1);
    }

    document.addEventListener("DOMContentLoaded", initializeRegistro);
    document.addEventListener("astro:page-load", initializeRegistro);
</script>
